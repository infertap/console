# Supply-chain posture, ported from the analyzer. Each line is a decision.
#
# ignore-scripts   a dependency does not get to run code at install time. The
#                  install-script vector is the cheapest supply-chain attack
#                  there is, and nothing in deps.md needs one.
# save-exact       no ranges in package.json. A caret is a promise a registry
#                  makes and cannot keep.
# fund/audit       fund noise off; audit runs in CI where a human reads it.
ignore-scripts=true
save-exact=true
fund=false
audit=false
