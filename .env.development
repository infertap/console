# Development only. Vite loads this for `vite` / `vite dev` (mode=development) and NEVER for
# `vite build` (mode=production), which is the whole point of putting it here rather than in an
# npm script: the mock is a property of the dev server, not of the artifact.
#
# `readSource` defaults to `live` precisely so that an unset variable cannot ship fiction. This
# file is how local development opts back INTO the mock, deliberately and visibly.
VITE_SOURCE=live
